#!/usr/bin/env python3
"""Template: explicit credential files inside one Hermes home only.

No outside-home files, discovery, scheduler, encryption or retention.
Do not execute/import this file during package authorship.
"""
from __future__ import annotations

import argparse
from datetime import datetime
import gzip
import hashlib
import io
import json
import os
from pathlib import Path
import stat
import sys
import tarfile


MAX_FILE_BYTES = 16 * 1024 * 1024  # Review explicitly for unusually large token stores.


def safe_path(path: Path) -> Path:
    path = path.expanduser()
    if not path.is_absolute() or '..' in path.parts:
        raise ValueError('Absolute path without parent traversal required')
    if any(p.is_symlink() for p in (path, *path.parents)):
        raise ValueError('Symlink path rejected')
    return path


def select_sources(home: Path, names: list[str]) -> list[tuple[str, Path]]:
    if not home.is_dir():
        raise ValueError('Hermes home missing')
    sources, seen = [], set()
    for name in names:
        rel = Path(name)
        if rel.is_absolute() or '..' in rel.parts or rel == Path('.'):
            raise ValueError('Only relative source files inside Hermes home')
        source = safe_path(home / rel)
        info = source.stat()
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise ValueError('Source must be a regular, unlinked file')
        if info.st_uid != os.getuid():
            raise ValueError('Source belongs to another user')
        identity = (info.st_dev, info.st_ino)
        if identity in seen:
            raise ValueError('Duplicate source')
        seen.add(identity)
        sources.append((rel.as_posix(), source))
    if not sources:
        raise ValueError('Empty source list')
    return sources


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open('rb') as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b''):
            digest.update(block)
    return digest.hexdigest()


def write_json(path: Path, value: dict) -> None:
    with path.open('x', encoding='utf-8') as handle:
        json.dump(value, handle, indent=2, ensure_ascii=True)
        handle.write('\n')
        handle.flush()
        os.fsync(handle.fileno())


def create_archive(sources: list[tuple[str, Path]], path: Path) -> dict:
    expected = {}
    with tarfile.open(path, mode='x:gz') as archive:
        for name, source in sources:
            safe_path(source)
            descriptor = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            with os.fdopen(descriptor, 'rb') as handle:
                before = os.fstat(handle.fileno())
                if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
                        or before.st_uid != os.getuid()):
                    raise ValueError('Source changed type or owner')
                payload = handle.read(MAX_FILE_BYTES + 1)
                after = os.fstat(handle.fileno())
            if len(payload) > MAX_FILE_BYTES:
                raise ValueError('Credential file exceeds reviewed size limit')
            if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (
                    after.st_size, after.st_mtime_ns, after.st_ctime_ns):
                raise ValueError('Credential file changed while reading')
            if len(payload) != before.st_size:
                raise ValueError('Credential read incomplete')
            if payload.startswith(b'SQLite format 3\x00'):
                raise ValueError('SQLite requires the DB snapshot script')
            member = tarfile.TarInfo(name)
            member.size = len(payload)
            member.mode = 0o600
            member.mtime = int(before.st_mtime)
            archive.addfile(member, io.BytesIO(payload))
            expected[name] = {'bytes': len(payload), 'sha256': hashlib.sha256(payload).hexdigest()}
    # Read gzip to EOF, including its CRC/footer, without extracting live files.
    with gzip.open(path, 'rb') as compressed:
        while compressed.read(1024 * 1024):
            pass
    observed = {}
    with tarfile.open(path, mode='r:gz') as archive:
        for member in archive:
            if (not member.isfile() or member.name not in expected
                    or member.name in observed or member.mode != 0o600):
                raise ValueError('Unexpected archive member')
            with archive.extractfile(member) as handle:
                payload = handle.read(MAX_FILE_BYTES + 1)
            observed[member.name] = {'bytes': len(payload), 'sha256': hashlib.sha256(payload).hexdigest()}
    if observed != expected:
        raise ValueError('Archive verification failed')
    return observed


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--home', required=True, type=Path)
    parser.add_argument('--out-base', type=Path, default=Path.home() / 'backups' / 'hermes')
    parser.add_argument('--file', required=True, action='append', help='Approved relative file path; repeat')
    args = parser.parse_args()
    os.umask(0o077)
    home, base = safe_path(args.home), safe_path(args.out_base)
    if home == base or base.is_relative_to(home) or home.is_relative_to(base):
        raise ValueError('Source and output trees must be disjoint')
    sources = select_sources(home, args.file)
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = base.stat()
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError('Backup root requires own user and mode 0700')
    now = datetime.now().astimezone()
    run = base / now.strftime('%Y-%m-%d_%H%M%S_%f')
    run.mkdir(mode=0o700)
    identity = {'format': 1, 'kind': 'credentials', 'hermes_home': str(home),
                'created': now.isoformat(), 'requested': [name for name, _ in sources]}
    write_json(run / 'INCOMPLETE.json', identity)
    partial = run / 'credentials.tar.gz.partial'
    members = create_archive(sources, partial)
    with partial.open('rb') as handle:
        os.fsync(handle.fileno())
    archive = run / 'credentials.tar.gz'
    partial.rename(archive)
    write_json(run / 'manifest.json', {**identity, 'members': members,
               'file': archive.name, 'bytes': archive.stat().st_size, 'sha256': sha256(archive)})
    write_json(run / 'COMPLETE.json', {**identity, 'manifest_sha256': sha256(run / 'manifest.json')})
    (run / 'INCOMPLETE.json').unlink()
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except Exception:
        # Never print credential values or exception payloads.
        print('Credential backup failed; no complete backup confirmed.', file=sys.stderr)
        sys.exit(1)
